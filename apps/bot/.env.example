POSTGRESQL_URL=postgres://tribunal:tribunal@localhost:5432/tribunal

DISCORD_BOT_TOKEN=your-bot-token
# Optional: servers, their AGENTS-like categories and their audio categories (defaults to « Le Royaume »), each comma-separated (id1,id2):
# DISCORD_GUILD_ID=
# DISCORD_AGENTS_CATEGORY_ID=
# DISCORD_VOICE_CATEGORY_ID=

OPENROUTER_API_KEY=sk-or-your-key
# Comma-separated preferred free models, "openrouter/free" is always tried last:
OPENROUTER_MODELS=

# Judge voice (Piper) and hearing transcription (whisper.cpp), see the README:
PIPER_URL=http://localhost:5000
PIPER_SPEAKER=8582
WHISPER_URL=http://localhost:8080

# Optional: Exa key (exa.ai) so the judge checks legal questions on the web and links his sources:
EXA_API_KEY=

# Courtroom WebSocket server, and where the bot reaches the web app to check sessions:
ROOM_PORT=3001
WEB_INTERNAL_URL=http://localhost:3000
# Public address of the web app, for the avatar mosaic of trials with several accused (empty: first avatar only):
WEB_PUBLIC_URL=
