{
  "name": "@tribunal/bot",
  "private": true,
  "type": "module",
  "exports": {
    "./room/*": "./src/room/*.ts",
    "./court/*": "./src/court/*.ts"
  },
  "scripts": {
    "start": "node --import @swc-node/register/esm-register ./src/main.ts",
    "dev": "nodemon -q -w ./src/ --exec node --import @swc-node/register/esm-register ./src/main.ts",
    "db:migration:create": "drizzle-kit generate",
    "ts:check": "tsc --noEmit"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.168",
    "dayjs": "^1.11.23",
    "dedent": "^1.7.2",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "ws": "8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@swc-node/register": "^1.12.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/ws": "8.18.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "drizzle-kit": "^0.31.11",
    "nodemon": "^3.1.14",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
